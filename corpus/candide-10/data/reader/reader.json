  "passages": [
    {
      "id": "p00001",
      "text": "\"Who was it that robbed me of my money and jewels?\"",
      "translation": "Qui a donc pu me voler mes pistoles et mes diamants?",
      "paragraph_id": "en-p00001",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00002",
      "text": "said Cunegonde, all\nbathed in tears. \"How shall we live?",
      "translation": "disait en pleurant\nCunégonde; de quoi vivrons-nous?",
      "paragraph_id": "en-p00001",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00003",
      "text": "What shall we do?",
      "translation": "comment ferons-nous?",
      "paragraph_id": "en-p00001",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00004",
      "text": "Where find\nInquisitors or Jews who will give me more?\"",
      "translation": "où trouver des\ninquisiteurs et des Juifs qui m’en donnent d’autres?",
      "paragraph_id": "en-p00001",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00005",
      "text": "\"Alas!\"",
      "translation": "Hélas!",
      "paragraph_id": "en-p00002",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00006",
      "text": "said the old woman, \"I have a shrewd suspicion of a reverend\nGrey Friar, who stayed last night in the same inn with us at Badajos.",
      "translation": "dit la\nvieille, je soupçonne fort un révérend père cordelier, qui coucha hier\ndans la même auberge que nous à Badajos; Dieu me garde de faire un\njugement téméraire!",
      "paragraph_id": "en-p00002",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [
