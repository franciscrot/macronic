      ],
      "sentences": []
    },
    {
      "id": "p00010",
      "text": "But according to these principles the Grey Friar\nought to have left us enough to carry us through our journey.",
      "translation": "Ce cordelier devait bien,\nsuivant ces principes, nous laisser de quoi achever notre voyage.",
      "paragraph_id": "en-p00003",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00011",
      "text": "Have you\nnothing at all left, my dear Cunegonde?\"",
      "translation": "Il ne\nvous reste donc rien du tout, ma belle Cunégonde?",
      "paragraph_id": "en-p00003",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00012",
      "text": "\"Not a farthing,\" said she.",
      "translation": "Pas un maravédis,\ndit-elle.",
      "paragraph_id": "en-p00004",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
    },
    {
      "id": "p00013",
      "text": "\"What then must we do?\"",
      "translation": "Quel parti prendre?",
      "paragraph_id": "en-p00005",
      "target_paragraph_id": "fr-p00001",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
      "sentences": []
