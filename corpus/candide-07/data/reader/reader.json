    {
      "id": "p00010",
      "text": "\"Who are you?\"",
      "translation": "Qui êtes-vous?",
      "paragraph_id": "en-p00006",
      "target_paragraph_id": "fr-p00002",
      "languages": {
        "base": "en",
        "learning": "fr"
      },
      "replacements": [],
